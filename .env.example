# =====================================================================
# Potion Discord -> Telegram Signals Bot - environment template
# Copy to .env and fill in. Never commit .env to git.
# =====================================================================

# ----- Discord listener (bot reading Potion channels) -----

# Bot token from https://discord.com/developers/applications
# Enable the "Message Content Intent" privileged intent.
DISCORD_BOT_TOKEN=

# Potion guild ID (server ID)
POTION_GUILD_ID=1260259552763580537

# Channel IDs to monitor
PREDICTION_CHANNEL_ID=1420272690459181118
MANUAL_PERP_CHANNEL_ID=1316518499283370064
MACS_CALLS_CHANNEL_ID=1495099327004016791
PINGU_CHARTS_CHANNEL_ID=1496462225945268385
BONDS_CHANNEL_ID=1495502715193917542
WALLET_TRACKER_CHANNEL_ID=1308117198463696967


# ----- Referral links attached to forwarded calls -----

REF_LINK_PERPS=https://partner.blofin.com/d/potion
REF_LINK_OSTIUM=https://app.ostium.com/?ref=PTION
REF_LINK_MEMECOIN=https://trade.padre.gg/rk/orangie
# Prediction calls = Polymarket. Plain link, no referral param.
REF_LINK_PREDICTION=https://polymarket.com

# Community link: when set, every signal alert gets a "Join the Discord"
# button (bottom row of the keyboard). Leave blank to hide the button.
POTION_DISCORD_URL=


# ----- Telegram DM bot -----

# Bot token from @BotFather.
# The bot DMs each verified user directly - there is no shared group.
# Users must /start the bot once (open a chat) before they can be DM'd.
TELEGRAM_BOT_TOKEN=


# ----- Dispatcher (DM fan-out rate limits) -----

# Telegram's global bot API limit is ~30 msgs/sec across all chats.
# 25 leaves headroom for reverify cron + command replies.
# At 25/sec: 500 users = 20s fan-out, 1000 users = 40s, 2000 users = 80s.
DISPATCHER_RATE_PER_SEC=25
DISPATCHER_MAX_CONCURRENT=25


# ----- Discord OAuth (Elite verification) -----

# Uses the SAME Discord application as DISCORD_BOT_TOKEN above.
# Go to https://discord.com/developers/applications/{YOUR_APP_ID}/oauth2
#
# Client ID = your Discord application ID (same as the bot ID).
# Client Secret = click "Reset Secret" on the OAuth2 page and copy once.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# The Discord role ID for Elite members in the Potion guild.
# Get this by enabling Developer Mode in Discord (User Settings -> Advanced)
# then right-clicking the Elite role -> Copy Role ID.
DISCORD_ELITE_ROLE_ID=

# URL shown to non-Elite users in the denial DM.
ELITE_SIGNUP_URL=https://whop.com/potion

# Cancel-survey DM watcher: when a member loses the Elite role, the bot
# DMs them this URL with ?type=exit&member_id=...&username=... appended.
# Leave empty to disable the watcher.
CANCEL_SURVEY_URL=https://potion-feedback.netlify.app


# ----- OAuth callback server -----

# Public HTTPS URL of the /oauth/discord/callback endpoint.
# - Local dev: ngrok http 8080 -> https://abc123.ngrok.io/oauth/discord/callback
# - Production: your real domain pointing at this container
# This URL must ALSO be added to the Discord application's OAuth2 Redirects.
OAUTH_REDIRECT_URI=

# Port the aiohttp callback server listens on inside the container.
OAUTH_PORT=8080

# 32+ random hex characters used to HMAC-sign the OAuth state token.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=

# Fernet key used to encrypt Discord refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHOP_REFRESH_TOKEN_ENCRYPTION_KEY=


# ----- Email bot (win-back + re-engagement) -----

# Set to "true" to turn the email subsystem on. When false (or missing)
# the rest of the bot still works fine and email routes are unmounted.
EMAIL_BOT_ENABLED=false

# Resend API key (https://resend.com/api-keys). Only needed when enabled.
RESEND_API_KEY=

# Sending address. Must match a verified domain in your Resend account.
# Format: "Display Name <addr@your-verified-domain.com>"
RESEND_FROM_ADDRESS=Potion Alpha Team <seniormod@mail.potionalpha.com>

# Public HTTPS URL for the Ostium banner referenced in onboarding emails.
# Defaults empty (banner section omitted from the template). For production
# point this at the dashboard's /email-assets/ route — that path is
# whitelisted in dashboard middleware.ts so Gmail's image proxy can
# fetch it without the dashboard auth cookie:
#   https://potion-dashboard-production.up.railway.app/email-assets/ostium-banner.png
#
# Alternative (no internal infra, public CDN mirror of the GitHub repo):
#   https://cdn.jsdelivr.net/gh/Wuke-creator/potion-scanner@main/static/ostium-banner.png
#
# Both confirmed working with Gmail's image proxy. Avoid raw.githubusercontent.com
# (it sets Content-Security-Policy: sandbox which Gmail rejects).
OSTIUM_BANNER_URL=

# Membership-pause feature flag. The save-offer router maps cancel
# reasons "not_using" (Offer B) and "market_slow" (Offer C) to pause-
# based copy. Until the pause flow is live in Whop (with a real pause
# URL members can click), the templates render a discount-based fallback
# instead of promising pause. Set this to "true" / "1" the moment pause
# is shipped and the rejoin_url for those reasons can carry a working
# pause link.
PAUSE_FEATURE_ENABLED=false

# Public HTTPS URL for the Potion logo shown in every email header.
# Leave empty to use the default hosted asset (128x128 PNG, displayed
# at 64x64 for retina/hi-DPI sharpness):
#   https://potion-dashboard-production.up.railway.app/email-assets/potion-logo-128.png
POTION_LOGO_URL=

# HMAC-SHA256 shared secret for Whop webhook signature verification.
# Get this from the Whop developer dashboard when creating the webhook.
WHOP_WEBHOOK_SECRET=

# Shared secret for internal /webhook/inactivity + /admin/email/* routes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_WEBHOOK_SECRET=

# Svix-format signing secret for the Resend webhook receiver
# (POST /webhook/resend). Get this from the Resend dashboard when
# creating the webhook endpoint: https://resend.com/webhooks
# Format: starts with "whsec_" followed by base64. Without this set,
# the route still mounts but rejects every request as bad signature.
RESEND_WEBHOOK_SECRET=

# Optional: SQLite path for the Resend webhook event store.
# Defaults to data/email_events.db; override only if you want it on
# a different volume.
EMAIL_EVENTS_DB_PATH=data/email_events.db

# Whop checkout / rejoin URL used as the default CTA in every email.
POTION_REJOIN_URL=https://whop.com/potion

# Comma-separated Discord user IDs allowed to run /email-* slash commands.
# Example: DISCORD_ADMIN_USER_IDS=901091776977338419,222344473235947520
DISCORD_ADMIN_USER_IDS=

# ----- Whop API (backfills email column on verified_users) -----
# Used by the startup email sync + /sync-emails slash command to look up a
# member's email in Whop by their linked Discord user ID. Needed for Features
# 2 and 4 which rely on email delivery. Without this key those features
# gracefully no-op on users with empty email.
#
# Create the API key at:
#   https://whop.com/dashboard/biz_pn9Fq67uJNjgj1/developer/api-keys
# Company ID is the Potion Whop business id (safe to commit).
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_pn9Fq67uJNjgj1

# Separate Whop API key scoped only to promo_code:create + access_pass:basic:read.
# Bot uses it to mint single-use promo codes per cancelling member so leaked
# codes can only be redeemed once. Kept isolated from WHOP_API_KEY so a leak
# of either has minimal blast radius. Leave blank to fall back to the hardcoded
# offer codes in the frontend.
WHOP_PROMO_API_KEY=

# --- Bronze -> Elite upsell (sequence days 1 / 3 / 5; day 5 = a
# single-use 30%-off Elite code minted at send time, valid 14 days) ---
#
# Active mechanism is the daily Whop sync (Option 2). Set BOTH to arm it:
#
#   WHOP_BRONZE_FREE_PRODUCT_ID = the free-tier Whop product id.
#     Confirmed: "Free Discord" = prod_LVAuYCd2uhi7y
#   BRONZE_ENROLL_GO_LIVE_AT_EPOCH = unix epoch cutoff. ONLY members
#     whose free membership was created at/after this epoch get enrolled.
#     Set it to "now" when going live so the existing ~120k free-signup
#     backlog is NEVER blasted. 0 (default) = enrol nobody (dormant).
WHOP_BRONZE_FREE_PRODUCT_ID=
BRONZE_ENROLL_GO_LIVE_AT_EPOCH=

# Legacy webhook trigger (Option 1, superseded by the sync above). Left
# in place but dormant; leave blank. The sync is the live path.
WHOP_BRONZE_ACCESS_PASS_ID=


# ----- 1-Tap Trade (Ostium Builder SDK) -----

# Master switch. Set to "true" only after the trade-executor sidecar
# service is deployed and reachable. When false, /connect responds with
# "not enabled yet" and the 1-Tap button is hidden from signal alerts.
TRADING_ENABLED=false

# Base URL of the trade-executor Node service. On Railway use the private
# domain (no public HTTPS required for service-to-service):
#   http://potion-trade-executor.railway.internal:3001
TRADE_EXECUTOR_BASE_URL=

# Shared secret used to authenticate Python -> Node calls. Must match
# the value set on the trade-executor service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADE_EXECUTOR_SECRET=

# Ostium "builder" address: the wallet that receives builder fee bps on
# every trade routed through this bot. Leave blank to disable fee accrual
# (trades still fire normally).
OSTIUM_BUILDER_ADDRESS=

# Builder fee in basis points (0..50). 10 bps = 0.1% on opens.
# Setting this > 0 requires OSTIUM_BUILDER_ADDRESS to be set as well.
OSTIUM_BUILDER_FEE_BPS=0

# Per-trade collateral safety cap, USDC. Hard ceiling regardless of
# user input. Defaults to 5000.
TRADING_MAX_COLLATERAL_USDC=5000


# ----- Image archive (permanent chart storage on Telegram CDN) -----

# Telegram chat id where the bot uploads every signal-attached chart
# to get a permanent file_id. The file_id is saved on the open_signals
# row and reused for fan-out + lifecycle re-sends, so charts persist
# even after Discord's CDN URL expires (~24h).
#
# Recommended: create a private Telegram channel called "Potion Signal
# Archive", add @PotionScannerBot as admin, copy the channel id here
# (negative integer for channels, e.g. -1001234567890).
#
# When unset (0 or blank), images fall back to Discord URL passthrough.
IMAGE_ARCHIVE_CHAT_ID=


# ----- Logging -----

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

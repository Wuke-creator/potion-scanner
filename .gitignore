# Python distutils/setuptools build dirs. ANCHORED to repo root via the
# leading slash so the pattern doesn't accidentally catch nested
# directories named lib/ (e.g. dashboard/src/lib/, which IS source code
# that needs to be tracked).
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# TypeScript incremental compile cache. Regenerated on every build,
# would churn the repo + hide real source changes if committed.
*.tsbuildinfo

# One-off broadcast staging artifacts (rendered locally before each blast,
# not source — keep them out of git so a stale copy never gets re-sent
# accidentally and so they don't bloat the repo).
potion-2.0-announcement.html
potion-2.0-announcement.txt
potion_logo_datauri.txt

# Trade-executor sidecar: env vars set on the Railway service
# (project: fantastic-energy, service: potion-trade-executor)

# Shared secret. MUST match TRADE_EXECUTOR_SECRET on potion-scanner.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRADE_EXECUTOR_SECRET=

# Port the express server listens on. Railway exposes this internally
# at potion-trade-executor.railway.internal:${PORT}.
PORT=3001

# Optional: Arbitrum RPC URL for read calls (getPairs, getOrders).
# Leave blank to let @ostium/builder-sdk pick its default.
ARB_RPC_URL=

# Optional: override the Pimlico bundler URL. Leave blank to use the
# SDK's default Ostium-sponsored Arbitrum One bundler.
OSTIUM_PIMLICO_URL=

# Optional: Pimlico sponsorship policy ID. Only needed if Ostium gives
# us a custom policy.
OSTIUM_SPONSORSHIP_POLICY_ID=

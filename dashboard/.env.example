# Path to the bot's data folder. Defaults to ../data when running from
# inside the dashboard folder, which works both locally (sibling to the
# bot's data/) and on Railway (same container, same volume).
POTION_DATA_DIR=../data

# Bearer token gate. Required in production. The dashboard /auth?token=...
# endpoint sets a long-lived cookie with this token; subsequent requests
# without the cookie get 401. Pick a long random string. If unset, auth
# is disabled (dev only).
DASHBOARD_BEARER_TOKEN=

# Optional comma-separated allowlist of IPs that can reach the dashboard.
# Cloudflare/Railway forwards via x-forwarded-for so we trust the first
# entry in that header. Empty = no IP filtering.
DASHBOARD_ALLOWED_IPS=

# Comma-separated Discord user IDs of senior staff (used by the leadership
# panel and staff performance panel). The bot also reads this list via
# POTION_SENIOR_STAFF_IDS — keep both in sync if you change them.
POTION_SENIOR_STAFF_IDS=901091776977338419,197740443281129472,264434503362150400,885442563606196264

# Channel IDs (sourced once from .env so the dashboard can label them in
# the UI without going through Discord). Bot uses the same env var names.
POTION_GENERAL_CHANNEL_ID=1260259552763580540
POTION_ALPHA_CHANNEL_ID=1313660107963240489
POTION_TICKET_FORUM_ID=1285628366162231346
